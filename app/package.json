    "test:year": "node scripts/check-year.mjs",
    "test:profiles": "node scripts/check-profiles.mjs",
    "test:comparison": "node scripts/check-comparison.mjs",
    "test:usecases": "node scripts/check-usecases.mjs"
  },
  "devDependencies": {
    "elm": "0.19.1-6",
    "elm-format": "0.8.8",
    "playwright": "^1.56.0"
  }
}
